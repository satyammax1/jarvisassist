<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050B14"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <ImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_jarvis_launcher"
        android:contentDescription="J.A.R.V.I.S. Core" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="J.A.R.V.I.S."
        android:textColor="#00F0FF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.15" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Tap SPEAK and give a command..."
        android:textColor="#D0F4FF"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/micButton"
            android:layout_width="145dp"
            android:layout_height="145dp"
            android:backgroundTint="#00B8D4"
            android:text="SPEAK"
            android:textColor="#050B14"
            android:textSize="19sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/stopSpeakBtn"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginStart="16dp"
            android:backgroundTint="#7F1D1D"
            android:text="STOP"
            android:textColor="#FECACA"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/commandEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#00F0FF"
            android:hint="e.g. quiz / theory of machines book open"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#78909C" />

        <Button
            android:id="@+id/sendCmdBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#00F0FF"
            android:text="RUN"
            android:textColor="#050B14"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/pdfFolderBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#10253F"
        android:text="Select PDF Folder"
        android:textColor="#00F0FF" />

    <Button
        android:id="@+id/floatingBubbleBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:backgroundTint="#10253F"
        android:text="Floating Bubble: OFF"
        android:textColor="#00F0FF" />

    <Button
        android:id="@+id/accessibilityBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:backgroundTint="#10253F"
        android:text="Enable System Control (Accessibility)"
        android:textColor="#00F0FF" />

</LinearLayout>
