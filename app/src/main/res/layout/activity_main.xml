<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050B14"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="J.A.R.V.I.S."
        android:textColor="#00F0FF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:letterSpacing="0.15" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="Tap SPEAK and give a command..."
        android:textColor="#D0F4FF"
        android:textSize="16sp" />

    <Button
        android:id="@+id/micButton"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#00B8D4"
        android:text="SPEAK"
        android:textColor="#050B14"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/commandEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#00F0FF"
            android:hint="Type command (e.g. open youtube)"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#78909C" />

        <Button
            android:id="@+id/sendCmdBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#00F0FF"
            android:text="RUN"
            android:textColor="#050B14"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/accessibilityBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="#10253F"
        android:text="Enable System Control (Accessibility)"
        android:textColor="#00F0FF" />

</LinearLayout>
